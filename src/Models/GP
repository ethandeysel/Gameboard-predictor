import os
# Force linear algebra libraries to use 1 thread (prevents Windows segfaults)
os.environ["MKL_NUM_THREADS"] = "1"
os.environ["OPENBLAS_NUM_THREADS"] = "1"
os.environ["OMP_NUM_THREADS"] = "1"

import pymc as pm
import numpy as np
import arviz as az

def build_and_sample_gp(X_train, y_train, draws=100, tune=100):
    print("Building Spatiotemporal GP Model...")
    with pm.Model() as gp_model:
        ls_spatial = pm.Gamma('ls_spatial', alpha=2, beta=2)
        ls_temporal = pm.Gamma('ls_temporal', alpha=4, beta=2)
        eta = pm.HalfNormal('eta', sigma=2)

        k_spatial = pm.gp.cov.Matern52(3, ls=ls_spatial, active_dims=[0,1])
        k_temporal = pm.gp.cov.ExpQuad(3, ls=ls_temporal, active_dims=[2])
        cov_func = eta**2 * (k_spatial * k_temporal)

        mean_func = pm.gp.mean.Constant(c=pm.Normal("mean_base", mu=5.0, sigma=2.0))

        gp = pm.gp.Marginal(mean_func=mean_func, cov_func=cov_func)
        sigma_noise = pm.HalfNormal("sigma_noise", sigma=1.0)

        y_obs = gp.marginal_likelihood("y_obs", X=X_train, y=y_train, sigma=sigma_noise)
        
        print("Starting NUTS Sampler...")
        trace = pm.sample(draws=draws, tune=tune, chains=1, cores=1, random_seed=42)
        
    return gp_model, gp, trace

def predict_next_week(gp_model, gp, trace, target_week=20):
    X_new = []
    for tile_idx in range(20):
        x_coord, y_coord = tile_idx % 4, tile_idx // 4
        X_new.append([x_coord, y_coord, target_week])
    X_new = np.array(X_new, dtype=float)

    with gp_model:
        # Fixed Bug: Use the mean of the MCMC trace instead of the missing map_estimate
        trace_mean = az.summary(trace, kind="stats").to_dict()['mean']
        mu_pred, var_pred = gp.predict(X_new, point=trace_mean, diag=True)

    expected_rewards = np.exp(mu_pred + (var_pred / 2))
    standard_deviations = np.sqrt((np.exp(var_pred) - 1) * np.exp(2 * mu_pred + var_pred))

    kappa = 1.96 
    ucb_scores = expected_rewards + (kappa * standard_deviations)
    best_tile = np.argmax(ucb_scores)
    
    return best_tile, expected_rewards, ucb_scores